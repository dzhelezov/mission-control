{
  "_comment": [
    "mission-control -> ~/.prime/agent/settings.json (global) or <project>/.prime/agent/settings.json.",
    "Project settings override global; nested objects merge.",
    "defaultProvider/defaultModel set the interactive default only — the tick loop and bin/agent",
    "always pass --provider/--model explicitly, so the catalog in orchestration.toml stays the",
    "single source of truth. But point the default at a provider you are ACTUALLY logged into:",
    "subcommands (schedule, send, list) resolve the default model first and refuse to run when",
    "it has no credentials. Shipped default assumes the ChatGPT login; switch it if you skip that."
  ],

  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "xhigh",

  "enabledModels": ["gpt-5.6-*", "moonshotai/kimi-k3", "qwen/qwen3.8-max"],

  "warnings": {
    "anthropicExtraUsage": true
  },

  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000,
    "provider": { "maxRetryDelayMs": 60000 }
  },

  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },

  "idleEvictionMinutes": 90,
  "quietStartup": true
}
